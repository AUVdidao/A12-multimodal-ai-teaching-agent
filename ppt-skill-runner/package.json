{
  "name": "a12-ppt-skill-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Isolated presentation-skill runner for A12 Phase 1 PPTX generation.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node dist/test/runner.test.js",
    "generate:fixture": "npm run build && node dist/src/generate-fixture.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
