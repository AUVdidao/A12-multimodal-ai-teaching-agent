{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a12.local/schema/slide-spec.schema.json",
  "title": "A12 SlideSpec",
  "type": "object",
  "required": ["templateId", "templateVersion", "locale", "slides"],
  "properties": {
    "templateId": { "type": "string" },
    "templateVersion": { "type": "string" },
    "locale": { "type": "string", "enum": ["zh-CN"] },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["id", "layoutId", "title", "visualStrategy", "slots"],
        "properties": {
          "id": { "type": "string", "pattern": "^slide-[0-9]+$" },
          "layoutId": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 100 },
          "visualStrategy": { "type": "string", "minLength": 1, "maxLength": 300 },
          "slots": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 5000 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
