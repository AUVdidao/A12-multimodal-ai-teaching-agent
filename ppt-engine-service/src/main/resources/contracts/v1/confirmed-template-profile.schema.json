{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a12.local/contracts/v1/confirmed-template-profile.schema.json",
  "title": "Confirmed Template Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "profileId", "templateId", "projectId", "ownerUserId", "templateVersion", "profileVersion", "status", "pageSize", "spatialProfile", "templatePageReferences", "components"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "profileId": {"$ref": "#/$defs/id"},
    "templateId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "ownerUserId": {"$ref": "#/$defs/id"},
    "templateVersion": {"type": "integer", "minimum": 1, "maximum": 100000},
    "profileVersion": {"type": "integer", "minimum": 1, "maximum": 100000},
    "status": {"type": "string", "enum": ["CANDIDATE", "CONFIRMED"]},
    "pageSize": {"$ref": "#/$defs/pageSize"},
    "spatialProfile": {"$ref": "#/$defs/spatialProfile"},
    "templatePageReferences": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/pageReference"}},
    "components": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/component"}},
    "textFitPolicy": {"$ref": "#/$defs/textFitPolicy"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "pageSize": {
      "type": "object", "additionalProperties": false, "required": ["widthEmu", "heightEmu"],
      "properties": {"widthEmu": {"type": "integer", "minimum": 1, "maximum": 100000000}, "heightEmu": {"type": "integer", "minimum": 1, "maximum": 100000000}}
    },
    "spatialProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["safeMarginLeftEmu", "safeMarginTopEmu", "safeMarginRightEmu", "safeMarginBottomEmu"],
      "properties": {
        "safeMarginLeftEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "safeMarginTopEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "safeMarginRightEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "safeMarginBottomEmu": {"type": "integer", "minimum": 0, "maximum": 100000000}
      }
    },
    "pageReference": {
      "type": "object", "additionalProperties": false,
      "required": ["pageReferenceId", "sourceSlide", "semanticRole", "objectIds"],
      "properties": {
        "pageReferenceId": {"$ref": "#/$defs/id"},
        "sourceSlide": {"type": "integer", "minimum": 1, "maximum": 200},
        "semanticRole": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
        "objectIds": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "name", "semanticRole", "sourceSlide", "shapeRefs", "childComponentIds", "slots", "transformConstraint", "fixedStyle", "reusable", "confidence", "teacherConfirmed"],
      "properties": {
        "componentId": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "semanticRole": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
        "sourceSlide": {"type": "integer", "minimum": 1, "maximum": 200},
        "shapeRefs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/objectReference"}},
        "childComponentIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "slots": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/slot"}},
        "transformConstraint": {"type": "string", "enum": ["FIXED", "TRANSLATE_ONLY", "UNIFORM_SCALE", "STRETCH_X", "STRETCH_Y", "RESPONSIVE"]},
        "fixedStyle": {"$ref": "#/$defs/fixedStyle"},
        "reusable": {"type": "boolean"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "teacherConfirmed": {"type": "boolean"}
      }
    },
    "objectReference": {
      "type": "object", "additionalProperties": false, "required": ["objectType", "objectId"],
      "properties": {
        "objectType": {"type": "string", "enum": ["SHAPE", "GROUP", "PICTURE", "TEXT", "CHART", "TABLE"]},
        "objectId": {"$ref": "#/$defs/id"}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slotId", "semanticRole", "acceptedContentTypes", "bounds", "required", "capacityConstraint"],
      "properties": {
        "slotId": {"$ref": "#/$defs/id"},
        "semanticRole": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"},
        "acceptedContentTypes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "enum": ["TITLE", "BODY", "BULLETS", "QUOTE", "TABLE", "CHART", "IMAGE", "TEXT"]}},
        "bounds": {"$ref": "#/$defs/bounds"},
        "required": {"type": "boolean"},
        "capacityConstraint": {"$ref": "#/$defs/capacity"}
      }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["leftEmu", "topEmu", "widthEmu", "heightEmu"],
      "properties": {
        "leftEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "topEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "widthEmu": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "heightEmu": {"type": "integer", "minimum": 1, "maximum": 100000000}
      }
    },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["maxCharacters", "maxItems"],
      "properties": {
        "maxCharacters": {"type": ["integer", "null"], "minimum": 1, "maximum": 4000},
        "maxItems": {"type": ["integer", "null"], "minimum": 1, "maximum": 100}
      }
    },
    "fixedStyle": {
      "type": "object", "additionalProperties": false,
      "required": ["styleId", "fontToken", "colorToken", "preserveTheme"],
      "properties": {
        "styleId": {"$ref": "#/$defs/id"},
        "fontToken": {"type": "string", "minLength": 1, "maxLength": 128},
        "colorToken": {"type": "string", "minLength": 1, "maxLength": 128},
        "preserveTheme": {"type": "boolean"}
      }
    },
    "textFitPolicy": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "PROFILE_CONSTRAINED"}}},
          "then": {"properties": {"fontEnvironmentVersion": {"not": {"const": "UNBOUND"}}}}
        }
      ],
      "required": ["policyVersion", "mode", "fontEnvironmentVersion", "minimumFontSizePt", "defaultFontSizePt", "maximumFontSizePt", "fontSizeStepPt", "minimumLineSpacingPct", "defaultLineSpacingPct", "maximumLineSpacingPct", "lineSpacingStepPct", "maxTextBoxGrowthWidthEmu", "maxTextBoxGrowthHeightEmu", "minimumParagraphSpacingPt", "defaultParagraphSpacingPt", "maximumParagraphSpacingPt", "paragraphSpacingStepPt", "adjustmentOrder"],
      "properties": {
        "policyVersion": {"const": "1.0.0"},
        "mode": {"type": "string", "enum": ["NO_ADJUSTMENT_PROFILE_V1", "PROFILE_CONSTRAINED"]},
        "fontEnvironmentVersion": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "minimumFontSizePt": {"type": "integer", "minimum": 1, "maximum": 1000},
        "defaultFontSizePt": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maximumFontSizePt": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fontSizeStepPt": {"type": "integer", "minimum": 1, "maximum": 100},
        "minimumLineSpacingPct": {"type": "integer", "minimum": 1, "maximum": 1000},
        "defaultLineSpacingPct": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maximumLineSpacingPct": {"type": "integer", "minimum": 1, "maximum": 1000},
        "lineSpacingStepPct": {"type": "integer", "minimum": 1, "maximum": 100},
        "maxTextBoxGrowthWidthEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "maxTextBoxGrowthHeightEmu": {"type": "integer", "minimum": 0, "maximum": 100000000},
        "minimumParagraphSpacingPt": {"type": "integer", "minimum": 0, "maximum": 1000},
        "defaultParagraphSpacingPt": {"type": "integer", "minimum": 0, "maximum": 1000},
        "maximumParagraphSpacingPt": {"type": "integer", "minimum": 0, "maximum": 1000},
        "paragraphSpacingStepPt": {"type": "integer", "minimum": 1, "maximum": 100},
        "adjustmentOrder": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["FONT_SIZE", "LINE_SPACING", "TEXT_BOX_GROWTH", "PARAGRAPH_SPACING"]}}
      }
    }
  }
}
