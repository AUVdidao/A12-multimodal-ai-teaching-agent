# Copy to .env only after reviewing each value. Do not commit real secrets.

# Required by the Go server. Keep the same persistent key used by the current
# Go deployment if/when a controlled cutover is performed.
LESSONFORGE_ENCRYPTION_KEY=replace-with-the-current-persistent-key
LESSONFORGE_ENABLE_GENERATION_WORKER=false
LESSONFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Existing external resources used during the transition.
A12_SHARED_STORAGE_VOLUME=lessonforge-engine-shared
LESSONFORGE_NETWORK_NAME=lessonforge-a12-net

# Existing host bindings. Keep these unchanged during cutover.
HOST_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
MONITOR_PORT=8082

# A12 database/provider settings. Replace development defaults before any
# production-like deployment.
POSTGRES_DB=a12_teaching_agent
POSTGRES_USER=a12_user
POSTGRES_PASSWORD=a12_dev_password
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/a12_teaching_agent
SPRING_DATASOURCE_USERNAME=a12_user
SPRING_DATASOURCE_PASSWORD=a12_dev_password
A12_INTERNAL_SERVICE_TOKEN=
MOONSHOT_API_KEY=
A12_CREDENTIAL_ENCRYPTION_KEY=

# Keep generation disabled until the real PPTX Open -> Save -> Reopen gate has
# passed on a controlled test Mission.
