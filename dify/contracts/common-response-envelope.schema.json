{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a12/dify/common-response-envelope.schema.json",
  "title": "A12 Dify workflow response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflowCode",
    "success",
    "data",
    "warnings",
    "errors",
    "confidence",
    "traceHint"
  ],
  "properties": {
    "workflowCode": {
      "type": "string",
      "pattern": "^WF-0[1-7]$"
    },
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": ["object", "null"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "field", "retryable"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "field": {"type": ["string", "null"]},
          "retryable": {"type": "boolean"}
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "traceHint": {
      "type": "string",
      "maxLength": 128
    }
  }
}
