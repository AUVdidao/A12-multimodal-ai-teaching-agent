{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a12.local/schema/template-spec.schema.json",
  "title": "A12 TemplateSpec",
  "type": "object",
  "required": ["templateId", "version", "name", "locale", "previewRef", "stylePreset", "layouts"],
  "properties": {
    "templateId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
    "previewRef": { "type": "string", "minLength": 1, "maxLength": 256 },
    "stylePreset": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["layoutId", "slots", "capacity"],
        "properties": {
          "layoutId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "slots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
          },
          "capacity": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 5000 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
