SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080
HOST_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
MONITOR_PORT=8082
# Local demo only. Production must set false and use non-demo authentication.
VITE_DEMO_MODE=true
# KIMI is the real workflow provider. Set MOCK only for offline demos/tests.
AI_PROVIDER=KIMI
A12_AI_PROVIDER=KIMI
A12_AI_FALLBACK_TO_MOCK=false
# Kimi is used only by server-side services. Keep the real key in local .env.
MOONSHOT_API_KEY=
# Base64-encoded 32-byte AES key for encrypting user-saved AI credentials.
A12_CREDENTIAL_ENCRYPTION_KEY=
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_CONNECT_TIMEOUT_SECONDS=15
KIMI_REQUEST_ATTEMPTS=2
KIMI_RETRY_DELAY_MILLIS=1200
KIMI_WORKFLOW_MODEL=kimi-k2.6
KIMI_WORKFLOW_TIMEOUT_SECONDS=180
KIMI_WORKFLOW_MAX_COMPLETION_TOKENS=8000
KIMI_WORKFLOW_MAX_INPUT_CHARACTERS=60000
KIMI_ASSISTANT_MODEL=kimi-k2.6
KIMI_ASSISTANT_TIMEOUT_SECONDS=90
KIMI_ASSISTANT_MAX_COMPLETION_TOKENS=1600
APP_UPLOAD_DIR=/app/data/uploads
APP_MAX_UPLOAD_SIZE=209715200
A12_FLYWAY_ENABLED=true
A12_MATERIAL_PARSER_MODE=remote
A12_MATERIAL_PARSER_BASE_URL=http://file-parser-service:8080
A12_MATERIAL_PARSER_TIMEOUT_MS=120000
A12_MATERIAL_PARSER_MAX_REQUEST_BYTES=214958080
A12_ARTIFACT_GENERATOR_MODE=remote
A12_ARTIFACT_GENERATOR_BASE_URL=http://file-generator-service:8080
A12_ARTIFACT_GENERATOR_TIMEOUT_MS=15000
A12_SECURITY_ENABLED=true
A12_SESSION_HOURS=12
# Local demo only. Production must set false and replace all credentials.
A12_DEMO_SEED_ENABLED=true
A12_DEMO_LEADER_PASSWORD=Leader123!
A12_DEMO_TEACHER_PASSWORD=Teacher123!
A12_DEMO_STUDENT_PASSWORD=Student123!
A12_DEMO_MULTI_PASSWORD=Multi123!
MYSQL_DATABASE=a12_teaching_agent
MYSQL_USER=a12_user
MYSQL_PASSWORD=a12_dev_password
MYSQL_ROOT_PASSWORD=a12_root_password
POSTGRES_DB=a12_teaching_agent
POSTGRES_USER=a12_user
POSTGRES_PASSWORD=a12_dev_password
# Production must provide SPRING_DATASOURCE_* from a secret manager or deployment secret.
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/a12_teaching_agent
SPRING_DATASOURCE_USERNAME=a12_user
SPRING_DATASOURCE_PASSWORD=a12_dev_password
