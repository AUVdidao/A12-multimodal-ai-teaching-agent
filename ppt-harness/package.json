  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.20.0",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=20 <23" }
}
